# Required: used by every section's Strands agent (agent/quickstart-agent.ts)
OPENAI_API_KEY=

# Only for the threads sections (prebuilt-threads-drawer, headless-threads).
# Get it with: cd frontend && npx copilotkit@latest project select   (then copy the value here)
CPK_INTELLIGENCE_API_KEY=

# Only for the voice section: the mic button appears only when this is set.
OPENAI_TRANSCRIPTION_API_KEY=
